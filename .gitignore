# Terraform state (contains sensitive data)
# Includes LOCAL bootstrap state — never commit to Git
*.tfstate
*.tfstate.*
**/.terraform/
.terraform.lock.hcl

# Sensitive variable files (IPs, subscription IDs, etc.)
terraform.tfvars
*.tfvars
!*.tfvars.example

# Binary plan files (may contain sensitive variable values)
*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Secrets
secrets.yaml
